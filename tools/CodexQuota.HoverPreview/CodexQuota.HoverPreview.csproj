<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework><RollForward>Major</RollForward>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/CodexQuota.Core/CodexQuota.Core.csproj" />
    <Compile Include="../../src/CodexQuota.Tray/HoverCardRenderer.cs" Link="HoverCardRenderer.cs" />
    <Compile Include="../../src/CodexQuota.Tray/TrayMenuPainter.cs" Link="TrayMenuPainter.cs" />
    <!-- Development-only Linux raster QA, never shipped in the Windows EXE. -->
    <PackageReference Include="System.Drawing.Common" Version="6.0.0" />
    <RuntimeHostConfigurationOption Include="System.Drawing.EnableUnixSupport" Value="true" />
  </ItemGroup>
</Project>
