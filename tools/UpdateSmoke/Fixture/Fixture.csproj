<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net48</TargetFramework>
    <AssemblyName>CodexQuotaTray</AssemblyName><PlatformTarget>x64</PlatformTarget>
    <Version>$(FixtureVersion)</Version><AssemblyVersion>$(FixtureVersion)</AssemblyVersion><FileVersion>$(FixtureVersion)</FileVersion>
    <BaseOutputPath>bin/$(FixtureVersion)/</BaseOutputPath>
    <StartupObject>CodexQuota.Tray.Bootstrap</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../src/CodexQuota.Core/CodexQuota.Core.csproj" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
    <Compile Include="../../../src/CodexQuota.Tray/Bootstrap.cs" Link="Bootstrap.cs" />
    <Compile Include="../../../src/CodexQuota.Tray/UpdateTransaction.cs" Link="UpdateTransaction.cs" /><Compile Include="../../../src/CodexQuota.Tray/FrameworkCompatibility.cs" Link="FrameworkCompatibility.cs" />
  </ItemGroup>
  <Target Name="EmbedFrameworkDependencies" AfterTargets="ResolveReferences" BeforeTargets="PrepareResources">
    <ItemGroup><EmbeddedResource Include="@(ReferenceCopyLocalPaths)" Condition="'%(ReferenceCopyLocalPaths.Extension)' == '.dll'"><LogicalName>Embedded.%(Filename)%(Extension)</LogicalName><WithCulture>false</WithCulture></EmbeddedResource></ItemGroup>
  </Target>
</Project>
