<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <StartupObject>CodexQuota.FrameworkSmoke.Bootstrap</StartupObject>
    <AssemblyName>CodexQuotaFrameworkSmoke</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/CodexQuota.Core/CodexQuota.Core.csproj" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Compile Include="../../src/CodexQuota.Tray/HoverCardRenderer.cs" Link="HoverCardRenderer.cs" />
    <Compile Include="../../src/CodexQuota.Tray/NativeHoverTextPainter.cs" Link="NativeHoverTextPainter.cs" />
    <Compile Include="../../src/CodexQuota.Tray/SingleInstanceCoordinator.cs" Link="SingleInstanceCoordinator.cs" />
    <Compile Include="../../src/CodexQuota.Tray/LogonSessionIdentity.cs" Link="LogonSessionIdentity.cs" />
    <Compile Include="../../src/CodexQuota.Tray/TrayVisibilityClient.cs" Link="TrayVisibilityClient.cs" />
    <Compile Include="../../src/CodexQuota.Tray/TrayVisibilityHelper.cs" Link="TrayVisibilityHelper.cs" />
    <EmbeddedResource Include="../../third_party/*.txt"><LogicalName>Legal.%(Filename)%(Extension)</LogicalName><WithCulture>false</WithCulture></EmbeddedResource>
  </ItemGroup>
  <Target Name="EmbedFrameworkDependencies" AfterTargets="ResolveReferences" BeforeTargets="PrepareResources">
    <ItemGroup>
      <EmbeddedResource Include="@(ReferenceCopyLocalPaths)" Condition="'%(ReferenceCopyLocalPaths.Extension)' == '.dll'">
        <LogicalName>Embedded.%(Filename)%(Extension)</LogicalName>
        <WithCulture>false</WithCulture>
      </EmbeddedResource>
    </ItemGroup>
  </Target>
</Project>
